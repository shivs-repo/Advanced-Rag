# Copy this file to .env and fill in your actual keys
# cp .env.example .env

# Pinecone — create a serverless index (1536-dim, cosine, aws us-east-1)
PINECONE_API_KEY=<your_pinecone_api_key>
PINECONE_INDEX=hr-rag
PINECONE_POLICY_INDEX=policy-rag

# OpenRouter — used for both embeddings (text-embedding-3-small) and LLM (gpt-4o-mini)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=<your_openrouter_api_key>

# HuggingFace — required to download meta-llama/Llama-Guard-3-1B
# 1. Free account at https://huggingface.co/settings/tokens
# 2. Accept model terms at https://huggingface.co/meta-llama/Llama-Guard-3-1B
HF_TOKEN=<your_huggingface_token>

# Neo4j Aura — Graph RAG
# Get from https://console.neo4j.io → your instance → Connect
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo4j_aura_password>
