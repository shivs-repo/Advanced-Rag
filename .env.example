# Copy this file to .env and fill in your actual keys
# cp .env.example .env

# Pinecone — create a serverless index (1536-dim, cosine, aws us-east-1)
PINECONE_API_KEY=<your_pinecone_api_key>
PINECONE_INDEX=hr-rag

# OpenRouter — used for both embeddings (text-embedding-3-small) and LLM (gpt-4o-mini)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=<your_openrouter_api_key>
